{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/list_items.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/c"
              },
              {
                "$ref": "#/$defs/i"
              },
              {
                "$ref": "#/$defs/u"
              }
            ]
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "total",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/e"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "c": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/A"
        },
        "view": {
          "$ref": "#/$defs/A"
        },
        "state": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "view",
        "state"
      ],
      "additionalProperties": false
    },
    "t": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "shown",
                "omitted_by_user",
                "not_authored"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "covered"
            },
            "by": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "not_drawable"
            },
            "reason_code": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason_code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "i": {
      "type": "object",
      "properties": {
        "item": {
          "type": "object"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension_kind": {
          "$ref": "#/$defs/A"
        },
        "placement": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchors": {
          "$ref": "#/$defs/B"
        },
        "features": {
          "$ref": "#/$defs/B"
        },
        "basis": {
          "type": "string"
        },
        "operations": {
          "$ref": "#/$defs/B"
        }
      },
      "required": [
        "item",
        "value",
        "dimension_kind",
        "placement",
        "anchors",
        "features",
        "basis",
        "operations"
      ],
      "additionalProperties": false
    },
    "u": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/A"
        },
        "detail_ref": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "detail_ref"
      ],
      "additionalProperties": false
    },
    "e": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "$ref": "#/$defs/B"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "A": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "B": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
