{
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "id": {
          "type": "string"
        },
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "view": {
                "enum": [
                  "front",
                  "plan",
                  "side"
                ]
              },
              "side": {
                "enum": [
                  "above",
                  "below",
                  "left",
                  "right"
                ]
              },
              "lane": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "along": {
                "anyOf": [
                  {
                    "enum": [
                      "start",
                      "middle",
                      "end",
                      "outside"
                    ]
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ]
              },
              "offset": {
                "$ref": "#/B"
              },
              "pinned": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "settable": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "choices": {
                "type": "array",
                "items": {}
              },
              "range": {
                "$ref": "#/B"
              },
              "integer": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^(forms|fields|paths|consequences)$(?!\\s)": {
                "$ref": "#/A"
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "minProperties": 6,
      "patternProperties": {
        "^(operations|view_anchors|scales)$(?!\\s)": {
          "$ref": "#/A"
        }
      }
    },
    {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "$ref": "#/A"
          },
          "code": {
            "enum": [
              "invalid",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "required": [
        "error"
      ],
      "maxProperties": 1
    }
  ],
  "A": {
    "items": {
      "type": "string"
    },
    "type": "array"
  },
  "B": {
    "items": {
      "type": "number"
    },
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
  }
}
