              "type": [
                "string",
                "null"
              ]
            },
            "scale": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "fit_limits": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "fit_deviations": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "projection": {
              "enum": [
                null,
                "first",
                "third"
              ]
            },
            "default_finish": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "feature_declarations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "faces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "faces"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(views|dimensions|annotations|features|faces)$(?!\\s)": {
          "additionalProperties": {
            "type": "object"
          },
          "type": "object"
        },
        "^(notes|tables|gears)$(?!\\s)": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      }
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "detail": {
      "type": "boolean"
    },
    "ops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/op"
      },
      "maxItems": 32
    }
  },
  "required": [
    "part_ref",
    "ops",
    "parent"
  ],
  "additionalProperties": false,
  "$defs": {
    "op": {
      "anyOf": [
        {
          "properties": {
            "op": {
              "enum": [
                "set",
                "add"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {}
          },
          "required": [
            "op",
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "op": {
              "const": "remove"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        }
      ],
      "type": "object"
    }
  },
  "patternProperties": {
    "^(part_ref|spec_version|drawing_ref|parent)$(?!\\s)": {
      "type": "string"
    }
  }
