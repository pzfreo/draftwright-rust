{
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheets": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "smallest_scale": {
              "$ref": "#/A"
            },
            "keep_together": {
              "type": "array",
              "items": {
                "$ref": "#/B"
              }
            },
            "gdt_on_sheet_1": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(max|hole_table)$(?!\\s)": {
              "enum": [
                null,
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                9
              ]
            }
          }
        },
        "sheet": {
          "type": "object",
          "properties": {
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "projection": {
              "enum": [
                null,
                "first",
                "third"
              ]
            },
            "default_finish": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(fit_limits|fit_deviations|hidden|centre_marks|centre_lines|thread_depiction|knurl_depiction)$(?!\\s)": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "^(size|scale)$(?!\\s)": {
              "$ref": "#/A"
            }
          }
        },
        "views": {
          "additionalProperties": {
            "patternProperties": {
              "^(hidden|centre_marks|centre_lines|thread_depiction|knurl_depiction)$(?!\\s)": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "feature_declarations": {
          "items": {
            "properties": {
              "faces": {
                "$ref": "#/B"
              }
            },
            "additionalProperties": {
              "type": "string"
            },
            "required": [
              "id",
              "kind",
              "faces"
            ],
            "maxProperties": 3
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(views|dimensions|annotations|features|faces)$(?!\\s)": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "^(notes|tables|gears|feature_declarations)$(?!\\s)": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "part": {
      "type": "integer",
      "minimum": 0
    },
    "detail": {
      "type": "boolean"
    },
    "problem_filter": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            null,
            "info",
            "warning",
            "error"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(code|subject|feature)$(?!\\s)": {
          "$ref": "#/A"
        }
      }
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "step"
      ]
    },
    {
      "required": [
        "part_ref"
      ]
    }
  ],
  "patternProperties": {
    "^(part_ref|spec_version|drawing_ref|step|features)$(?!\\s)": {
      "type": "string"
    }
  },
  "A": {
    "type": [
      "string",
      "null"
    ]
  },
  "B": {
    "items": {
      "type": "string"
    },
    "type": "array"
  }
}
