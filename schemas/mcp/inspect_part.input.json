{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/inspect_part.input.json",
  "type": "object",
  "properties": {
    "part_ref": {
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/s"
    },
    "spec_version": {
      "type": "string"
    },
    "drawing_ref": {
      "type": "string"
    },
    "step": {
      "type": "string"
    },
    "features": {
      "type": "string"
    },
    "detail": {
      "type": "boolean"
    },
    "problem_filter": {
      "type": "object",
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "step"
      ]
    },
    {
      "required": [
        "part_ref"
      ]
    }
  ],
  "$defs": {
    "s": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "type": [
                "string",
                "null"
              ]
            },
            "scale": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "fit_limits": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "views": {
          "$ref": "#/$defs/A"
        },
        "dimensions": {
          "$ref": "#/$defs/A"
        },
        "annotations": {
          "$ref": "#/$defs/A"
        },
        "features": {
          "$ref": "#/$defs/A"
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "A": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    }
  }
}
