{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/list_problems.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "subjects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "fix": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "enum": [
                                "set",
                                "add"
                              ]
                            },
                            "path": {
                              "type": "string"
                            },
                            "value": {}
                          },
                          "required": [
                            "op",
                            "path",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "const": "remove"
                            },
                            "path": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "op",
                            "path"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "code",
                  "severity",
                  "message",
                  "subjects"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "subjects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "code",
                  "severity",
                  "subjects"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "detail_ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "detail_ref"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "total",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
