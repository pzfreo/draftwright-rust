{
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "schema": {
          "const": "draftwright.analysis/7"
        },
        "binding": {
          "type": "object",
          "required": [
            "source_sha256",
            "part",
            "face_count",
            "loader"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^(source_sha256|part|loader)$(?!\\s)": {
              "type": "string"
            },
            "^(face_count|part_index)$(?!\\s)": {
              "minimum": 0,
              "type": "integer"
            }
          }
        },
        "envelope": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 2
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "iso_bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "schema",
        "binding",
        "envelope",
        "iso_bounds"
      ]
    },
    {
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid",
                "failed"
              ]
            },
            "message": {
              "type": "string"
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
