{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/view_sheet.input.json",
  "type": "object",
  "properties": {
    "part_ref": {
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/s"
    },
    "spec_version": {
      "type": "string"
    },
    "drawing_ref": {
      "type": "string"
    },
    "region": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "overlay_ids": {
      "type": "boolean"
    },
    "dpi": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 400
    }
  },
  "required": [
    "part_ref"
  ],
  "additionalProperties": false,
  "$defs": {
    "s": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "type": [
                "string",
                "null"
              ]
            },
            "scale": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "fit_limits": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "views": {
          "$ref": "#/$defs/A"
        },
        "dimensions": {
          "$ref": "#/$defs/A"
        },
        "annotations": {
          "$ref": "#/$defs/A"
        },
        "features": {
          "$ref": "#/$defs/A"
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "A": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    }
  }
}
