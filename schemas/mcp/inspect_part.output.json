{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/inspect_part.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "part_ref": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "face_count": {
          "type": "integer",
          "minimum": 0
        },
        "envelope": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 2
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "scale": {
              "type": "string"
            },
            "page": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "size",
            "scale",
            "page"
          ],
          "additionalProperties": false
        },
        "views": {
          "$ref": "#/$defs/A"
        },
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "problems": {
          "type": "integer",
          "minimum": 0
        },
        "spec_version": {
          "type": "string"
        },
        "plan_ref": {
          "type": "string"
        },
        "key_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "problem_page": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/r"
                  },
                  {
                    "$ref": "#/$defs/u"
                  }
                ]
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "items",
            "total",
            "next_cursor"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "part_ref",
        "part",
        "face_count",
        "envelope",
        "sheet",
        "views",
        "items",
        "problems",
        "spec_version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/e"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "r": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "subjects": {
          "$ref": "#/$defs/A"
        },
        "fix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          }
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "subjects"
      ],
      "additionalProperties": false
    },
    "op": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "set",
                "add"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {}
          },
          "required": [
            "op",
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "u": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail_ref": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "detail_ref"
      ],
      "additionalProperties": false
    },
    "e": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "$ref": "#/$defs/A"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "A": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
