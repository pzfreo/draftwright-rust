{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/item_options.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operations": {
          "$ref": "#/$defs/shared0"
        },
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "view": {
                "enum": [
                  "front",
                  "plan",
                  "side"
                ]
              },
              "side": {
                "enum": [
                  "above",
                  "below",
                  "left",
                  "right"
                ]
              },
              "lane": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "along": {
                "anyOf": [
                  {
                    "enum": [
                      "start",
                      "middle",
                      "end",
                      "outside"
                    ]
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ]
              },
              "pinned": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "view_anchors": {
          "$ref": "#/$defs/shared0"
        },
        "scales": {
          "$ref": "#/$defs/shared0"
        }
      },
      "required": [
        "id",
        "operations",
        "placements",
        "view_anchors",
        "scales"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "$ref": "#/$defs/shared0"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "shared0": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
