{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/get_item.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/item"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "label": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "view": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "shown",
                            "omitted_by_user",
                            "not_authored"
                          ]
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "covered"
                        },
                        "by": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "by"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "not_drawable"
                        },
                        "reason_code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "reason_code"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "basis": {
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "kind",
                "label",
                "view",
                "state",
                "basis",
                "value",
                "operations"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "item": {
          "type": "object"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "placement": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "item",
        "value",
        "dimension_kind",
        "placement",
        "anchors",
        "features",
        "basis",
        "operations"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
