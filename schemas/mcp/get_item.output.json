{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/get_item.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/i"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "view": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "$ref": "#/$defs/t"
                },
                "basis": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "operations": {
                  "$ref": "#/$defs/A"
                }
              },
              "required": [
                "id",
                "kind",
                "label",
                "view",
                "state",
                "basis",
                "value",
                "operations"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/e"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "i": {
      "type": "object",
      "properties": {
        "item": {
          "type": "object"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "dimension_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "placement": {
          "type": [
            "object",
            "null"
          ]
        },
        "anchors": {
          "$ref": "#/$defs/A"
        },
        "features": {
          "$ref": "#/$defs/A"
        },
        "basis": {
          "type": "string"
        },
        "operations": {
          "$ref": "#/$defs/A"
        }
      },
      "required": [
        "item",
        "value",
        "dimension_kind",
        "placement",
        "anchors",
        "features",
        "basis",
        "operations"
      ],
      "additionalProperties": false
    },
    "t": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "shown",
                "omitted_by_user",
                "not_authored"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "covered"
            },
            "by": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "not_drawable"
            },
            "reason_code": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason_code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "e": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "$ref": "#/$defs/A"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "A": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
