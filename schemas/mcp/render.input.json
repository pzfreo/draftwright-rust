{
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheets": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "smallest_scale": {
              "$ref": "#/B"
            },
            "keep_together": {
              "type": "array",
              "items": {
                "$ref": "#/A"
              }
            },
            "gdt_on_sheet_1": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(max|hole_table)$(?!\n)": {
              "enum": [
                null,
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                9
              ]
            }
          }
        },
        "sheet": {
          "type": "object",
          "properties": {
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "projection": {
              "enum": [
                null,
                "first",
                "third"
              ]
            },
            "default_finish": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(hidden|fit_(limits|deviations)|centre_(marks|lines)|(thread|knurl)_depiction)$(?!\n)": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "^(size|scale)$(?!\n)": {
              "$ref": "#/B"
            }
          }
        },
        "views": {
          "additionalProperties": {
            "patternProperties": {
              "^(hidden|centre_(marks|lines)|(thread|knurl)_depiction)$(?!\n)": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "feature_declarations": {
          "items": {
            "properties": {
              "faces": {
                "$ref": "#/A"
              }
            },
            "additionalProperties": {
              "type": "string"
            },
            "required": [
              "id",
              "kind",
              "faces"
            ],
            "maxProperties": 3
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(views|dimensions|annotations|features|faces|dimension_schemes)$(?!\n)": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "^(notes|tables|gears|feature_declarations)$(?!\n)": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "part": {
      "type": "integer",
      "minimum": 0
    },
    "format": {
      "enum": [
        "png",
        "pdf"
      ]
    },
    "region": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "overlay_ids": {
      "type": [
        "boolean",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "sheet": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ]
    },
    "dpi": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 400
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "step"
      ]
    },
    {
      "required": [
        "part_ref"
      ]
    }
  ],
  "patternProperties": {
    "^(spec_version|step|features|(part|drawing)_ref)$(?!\n)": {
      "type": "string"
    }
  },
  "A": {
    "items": {
      "type": "string"
    },
    "type": "array"
  },
  "B": {
    "type": [
      "string",
      "null"
    ]
  }
}
