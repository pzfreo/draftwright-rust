{
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "status": {
          "enum": [
            "clear",
            "needs_attention"
          ]
        },
        "completeness": {
          "type": "object",
          "properties": {},
          "required": [
            "claimed_faces",
            "faces",
            "unplanned_features"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^(claimed_faces|faces|unplanned_features)$": {
              "minimum": 0,
              "type": "integer"
            }
          }
        },
        "envelope": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 2
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "scale": {
              "type": "string"
            },
            "page": {
              "$ref": "#/$defs/A"
            }
          },
          "required": [
            "size",
            "scale",
            "page"
          ],
          "additionalProperties": false
        },
        "sheets": {
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9
          ]
        },
        "sheet_details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5,
                  6,
                  7,
                  8,
                  9
                ]
              },
              "size": {
                "type": "string"
              },
              "scale": {
                "type": "string"
              },
              "page": {
                "$ref": "#/$defs/A"
              }
            },
            "required": [
              "number",
              "size",
              "scale",
              "page"
            ],
            "additionalProperties": false
          }
        },
        "views": {
          "$ref": "#/$defs/B"
        },
        "key_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "problem_page": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "subjects": {
                        "$ref": "#/$defs/B"
                      },
                      "fix": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "op": {
                                  "enum": [
                                    "set",
                                    "add"
                                  ]
                                },
                                "path": {
                                  "type": "string"
                                },
                                "value": {}
                              },
                              "required": [
                                "op",
                                "path",
                                "value"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "op": {
                                  "const": "remove"
                                },
                                "path": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "op",
                                "path"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "id",
                      "code",
                      "severity",
                      "subjects"
                    ],
                    "additionalProperties": false,
                    "patternProperties": {
                      "^(id|code|severity)$": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "detail_ref": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "detail_ref"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "next_cursor": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "items",
            "total",
            "next_cursor"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "part_ref",
        "part",
        "face_count",
        "status",
        "completeness",
        "envelope",
        "sheet",
        "views",
        "items",
        "problems",
        "spec_version"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(part_ref|part|spec_version|plan_ref)$": {
          "type": "string"
        },
        "^(face_count|items|problems)$": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    {
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid",
                "failed"
              ]
            },
            "message": {
              "type": "string"
            },
            "choices": {
              "$ref": "#/$defs/B"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "A": {
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "B": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
