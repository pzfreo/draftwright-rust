{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/view_sheet.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "artifact_ref": {
          "type": "string"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "application/pdf"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "spec_version": {
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "mime_type",
        "bytes",
        "spec_version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
