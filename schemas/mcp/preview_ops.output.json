{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/preview_ops.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "events": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "change": {
                        "enum": [
                          "changed",
                          "added"
                        ]
                      },
                      "item": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/c"
                          },
                          {
                            "$ref": "#/$defs/i"
                          },
                          {
                            "$ref": "#/$defs/u"
                          }
                        ]
                      }
                    },
                    "required": [
                      "change",
                      "item"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "change": {
                        "const": "removed"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "change",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "change": {
                        "enum": [
                          "problem_added",
                          "problem_resolved"
                        ]
                      },
                      "problem": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/p"
                          },
                          {
                            "$ref": "#/$defs/r"
                          },
                          {
                            "$ref": "#/$defs/u"
                          }
                        ]
                      }
                    },
                    "required": [
                      "change",
                      "problem"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "$ref": "#/$defs/u"
                  }
                ]
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "items",
            "total",
            "next_cursor"
          ],
          "additionalProperties": false
        },
        "delta_ref": {
          "type": "string"
        },
        "plans": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "events",
        "delta_ref",
        "plans"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/e"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "c": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "view": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "view",
        "state"
      ],
      "additionalProperties": false
    },
    "t": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "shown",
                "omitted_by_user",
                "not_authored"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "covered"
            },
            "by": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "not_drawable"
            },
            "reason_code": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason_code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "i": {
      "type": "object",
      "properties": {
        "item": {
          "type": "object"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "dimension_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "placement": {
          "type": [
            "object",
            "null"
          ]
        },
        "anchors": {
          "$ref": "#/$defs/A"
        },
        "features": {
          "$ref": "#/$defs/A"
        },
        "basis": {
          "type": "string"
        },
        "operations": {
          "$ref": "#/$defs/A"
        }
      },
      "required": [
        "item",
        "value",
        "dimension_kind",
        "placement",
        "anchors",
        "features",
        "basis",
        "operations"
      ],
      "additionalProperties": false
    },
    "u": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail_ref": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "detail_ref"
      ],
      "additionalProperties": false
    },
    "p": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "subjects": {
          "$ref": "#/$defs/A"
        },
        "refs": {
          "$ref": "#/$defs/A"
        },
        "fix": {
          "$ref": "#/$defs/B"
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "message",
        "subjects"
      ],
      "additionalProperties": false
    },
    "op": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "set",
                "add"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {}
          },
          "required": [
            "op",
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "r": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "subjects": {
          "$ref": "#/$defs/A"
        },
        "fix": {
          "$ref": "#/$defs/B"
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "subjects"
      ],
      "additionalProperties": false
    },
    "e": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "$ref": "#/$defs/A"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "A": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "B": {
      "items": {
        "$ref": "#/$defs/op"
      },
      "type": "array"
    }
  }
}
