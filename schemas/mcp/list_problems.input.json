{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/list_problems.input.json",
  "type": "object",
  "properties": {
    "part_ref": {
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "spec_version": {
      "type": "string"
    },
    "drawing_ref": {
      "type": "string"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "detail": {
      "type": "boolean"
    },
    "filter": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/shared1"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "$ref": "#/$defs/shared1"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "part_ref"
  ],
  "additionalProperties": false,
  "$defs": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "$ref": "#/$defs/shared1"
            },
            "scale": {
              "$ref": "#/$defs/shared1"
            },
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "views": {
          "$ref": "#/$defs/shared0"
        },
        "dimensions": {
          "$ref": "#/$defs/shared0"
        },
        "annotations": {
          "$ref": "#/$defs/shared0"
        },
        "features": {
          "$ref": "#/$defs/shared0"
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "shared0": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "shared1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
