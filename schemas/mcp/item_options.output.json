{
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "id": {
          "type": "string"
        },
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "view": {
                "enum": [
                  "front",
                  "plan",
                  "side"
                ]
              },
              "side": {
                "enum": [
                  "above",
                  "below",
                  "left",
                  "right"
                ]
              },
              "lane": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "along": {
                "anyOf": [
                  {
                    "enum": [
                      "start",
                      "middle",
                      "end",
                      "outside"
                    ]
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ]
              },
              "offset": {
                "$ref": "#/$defs/A"
              },
              "pinned": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "settable": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "choices": {
                "type": "array",
                "items": {}
              },
              "range": {
                "$ref": "#/$defs/A"
              },
              "integer": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^(forms|fields|paths|consequences)$": {
                "$ref": "#/$defs/B"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "operations",
        "placements",
        "view_anchors",
        "scales",
        "settable"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(operations|view_anchors|scales)$": {
          "$ref": "#/$defs/B"
        }
      }
    },
    {
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid",
                "failed"
              ]
            },
            "message": {
              "type": "string"
            },
            "choices": {
              "$ref": "#/$defs/B"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "A": {
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "B": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
