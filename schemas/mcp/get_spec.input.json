{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/get_spec.input.json",
  "type": "object",
  "properties": {
    "part_ref": {
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/s"
    },
    "spec_version": {
      "type": "string"
    },
    "drawing_ref": {
      "type": "string"
    }
  },
  "required": [
    "part_ref"
  ],
  "additionalProperties": false,
  "$defs": {
    "s": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scale": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "fit_limits": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "views": {
          "$ref": "#/$defs/A"
        },
        "dimensions": {
          "$ref": "#/$defs/A"
        },
        "annotations": {
          "$ref": "#/$defs/A"
        },
        "features": {
          "$ref": "#/$defs/A"
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "A": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    }
  }
}
