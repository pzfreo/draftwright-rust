/* Specify PR #25's semantic text form, with one-based note index integers.
   Inject into parts/plate.step: #4 is the PRODUCT_DEFINITION_SHAPE and #713
   its representation context. File order deliberately differs from note order. */
#50000=DESCRIPTIVE_REPRESENTATION_ITEM('general note','ETCH PART NUMBER');
#50001=INTEGER_REPRESENTATION_ITEM('note index',3);
#50002=GENERAL_PROPERTY('','semantic text',$);
#50003=PROPERTY_DEFINITION('semantic text','user defined attribute',#4);
#50004=REPRESENTATION('',(#50000,#50001),#713);
#50005=PROPERTY_DEFINITION_REPRESENTATION(#50003,#50004);
#50006=GENERAL_PROPERTY_ASSOCIATION('',$,#50002,#50003);
#50010=DESCRIPTIVE_REPRESENTATION_ITEM('general note','Inspect bore');
#50011=INTEGER_REPRESENTATION_ITEM('note index',1);
#50012=GENERAL_PROPERTY('','semantic text',$);
#50013=PROPERTY_DEFINITION('semantic text','user defined attribute',#4);
#50014=REPRESENTATION('',(#50010,#50011),#713);
#50015=PROPERTY_DEFINITION_REPRESENTATION(#50013,#50014);
#50016=GENERAL_PROPERTY_ASSOCIATION('',$,#50012,#50013);
#50020=DESCRIPTIVE_REPRESENTATION_ITEM('general note','DEBURR ALL EDGES');
#50021=INTEGER_REPRESENTATION_ITEM('note index',2);
#50022=GENERAL_PROPERTY('','semantic text',$);
#50023=PROPERTY_DEFINITION('semantic text','user defined attribute',#4);
#50024=REPRESENTATION('',(#50020,#50021),#713);
#50025=PROPERTY_DEFINITION_REPRESENTATION(#50023,#50024);
#50026=GENERAL_PROPERTY_ASSOCIATION('',$,#50022,#50023);
