{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/preview_ops.input.json",
  "type": "object",
  "properties": {
    "part_ref": {
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "spec_version": {
      "type": "string"
    },
    "drawing_ref": {
      "type": "string"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "detail": {
      "type": "boolean"
    },
    "ops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/op"
      },
      "maxItems": 100
    }
  },
  "required": [
    "part_ref",
    "ops"
  ],
  "additionalProperties": false,
  "$defs": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scale": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "views": {
          "$ref": "#/$defs/shared0"
        },
        "dimensions": {
          "$ref": "#/$defs/shared0"
        },
        "annotations": {
          "$ref": "#/$defs/shared0"
        },
        "features": {
          "$ref": "#/$defs/shared0"
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "op": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "set",
                "add"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {}
          },
          "required": [
            "op",
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "shared0": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    }
  }
}
