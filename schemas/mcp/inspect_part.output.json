{
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "part_ref": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "face_count": {
          "$ref": "#/$defs/A"
        },
        "status": {
          "enum": [
            "clear",
            "needs_attention"
          ]
        },
        "completeness": {
          "type": "object",
          "properties": {
            "claimed_faces": {
              "$ref": "#/$defs/A"
            },
            "faces": {
              "$ref": "#/$defs/A"
            },
            "unplanned_features": {
              "$ref": "#/$defs/A"
            }
          },
          "required": [
            "claimed_faces",
            "faces",
            "unplanned_features"
          ],
          "additionalProperties": false
        },
        "envelope": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 2
        },
        "sheet": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "scale": {
              "type": "string"
            },
            "page": {
              "$ref": "#/$defs/B"
            }
          },
          "required": [
            "size",
            "scale",
            "page"
          ],
          "additionalProperties": false
        },
        "sheets": {
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9
          ]
        },
        "sheet_details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5,
                  6,
                  7,
                  8,
                  9
                ]
              },
              "size": {
                "type": "string"
              },
              "scale": {
                "type": "string"
              },
              "page": {
                "$ref": "#/$defs/B"
              }
            },
            "required": [
              "number",
              "size",
              "scale",
              "page"
            ],
            "additionalProperties": false
          }
        },
        "views": {
          "$ref": "#/$defs/C"
        },
        "items": {
          "$ref": "#/$defs/A"
        },
        "problems": {
          "$ref": "#/$defs/A"
        },
        "spec_version": {
          "type": "string"
        },
        "plan_ref": {
          "type": "string"
        },
        "key_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "problem_page": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "severity": {
                        "type": "string"
                      },
                      "subjects": {
                        "$ref": "#/$defs/C"
                      },
                      "fix": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "properties": {
                                "op": {
                                  "enum": [
                                    "set",
                                    "add"
                                  ]
                                },
                                "path": {
                                  "type": "string"
                                },
                                "value": {}
                              },
                              "required": [
                                "op",
                                "path",
                                "value"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "properties": {
                                "op": {
                                  "const": "remove"
                                },
                                "path": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "op",
                                "path"
                              ],
                              "additionalProperties": false
                            }
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "code",
                      "severity",
                      "subjects"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "detail_ref": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "detail_ref"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "total": {
              "$ref": "#/$defs/A"
            },
            "next_cursor": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "items",
            "total",
            "next_cursor"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "part_ref",
        "part",
        "face_count",
        "status",
        "completeness",
        "envelope",
        "sheet",
        "views",
        "items",
        "problems",
        "spec_version"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid",
                "failed"
              ]
            },
            "message": {
              "type": "string"
            },
            "choices": {
              "$ref": "#/$defs/C"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "A": {
      "minimum": 0,
      "type": "integer"
    },
    "B": {
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "C": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
