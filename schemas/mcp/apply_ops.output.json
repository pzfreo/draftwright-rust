{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftwright.io/schemas/mcp/apply_ops.output.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "spec_version": {
          "type": "string"
        },
        "delta": {
          "type": "object",
          "properties": {
            "events": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "change": {
                            "enum": [
                              "changed",
                              "added"
                            ]
                          },
                          "item": {
                            "anyOf": [
                              {
                                "$ref": "#/$defs/compact"
                              },
                              {
                                "$ref": "#/$defs/item"
                              },
                              {
                                "$ref": "#/$defs/stub"
                              }
                            ]
                          }
                        },
                        "required": [
                          "change",
                          "item"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "change": {
                            "const": "removed"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "change",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "change": {
                            "enum": [
                              "problem_added",
                              "problem_resolved"
                            ]
                          },
                          "problem": {
                            "anyOf": [
                              {
                                "$ref": "#/$defs/problem"
                              },
                              {
                                "$ref": "#/$defs/problem_small"
                              },
                              {
                                "$ref": "#/$defs/stub"
                              }
                            ]
                          }
                        },
                        "required": [
                          "change",
                          "problem"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "$ref": "#/$defs/stub"
                      }
                    ]
                  }
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "next_cursor": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "items",
                "total",
                "next_cursor"
              ],
              "additionalProperties": false
            },
            "delta_ref": {
              "type": "string"
            },
            "plans": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "events",
            "delta_ref",
            "plans"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "spec_version",
        "delta"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "compact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/shared1"
        },
        "view": {
          "$ref": "#/$defs/shared1"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "view",
        "state"
      ],
      "additionalProperties": false
    },
    "state": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "shown",
                "omitted_by_user",
                "not_authored"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "covered"
            },
            "by": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "not_drawable"
            },
            "reason_code": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason_code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "item": {
      "type": "object",
      "properties": {
        "item": {
          "type": "object"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension_kind": {
          "$ref": "#/$defs/shared1"
        },
        "placement": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchors": {
          "$ref": "#/$defs/shared0"
        },
        "features": {
          "$ref": "#/$defs/shared0"
        },
        "basis": {
          "type": "string"
        },
        "operations": {
          "$ref": "#/$defs/shared0"
        }
      },
      "required": [
        "item",
        "value",
        "dimension_kind",
        "placement",
        "anchors",
        "features",
        "basis",
        "operations"
      ],
      "additionalProperties": false
    },
    "stub": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/shared1"
        },
        "detail_ref": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "detail_ref"
      ],
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "subjects": {
          "$ref": "#/$defs/shared0"
        },
        "refs": {
          "$ref": "#/$defs/shared0"
        },
        "fix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          }
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "message",
        "subjects"
      ],
      "additionalProperties": false
    },
    "op": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "set",
                "add"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {}
          },
          "required": [
            "op",
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "problem_small": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "subjects": {
          "$ref": "#/$defs/shared0"
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "subjects"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "$ref": "#/$defs/shared0"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "shared0": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "shared1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
