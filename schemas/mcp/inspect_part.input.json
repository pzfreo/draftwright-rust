{
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheets": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "smallest_scale": {
              "$ref": "#/A"
            },
            "keep_together": {
              "type": "array",
              "items": {
                "$ref": "#/B"
              }
            },
            "gdt_on_sheet_1": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(max|hole_table)$(?!\n)": {
              "enum": [
                null,
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                9
              ]
            }
          }
        },
        "sheet": {
          "type": "object",
          "properties": {
            "title": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "projection": {
              "enum": [
                null,
                "first",
                "third"
              ]
            },
            "default_finish": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(hidden|fit_(limits|deviations)|centre_(marks|lines)|(thread|knurl)_depiction)$(?!\n)": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "^(size|scale)$(?!\n)": {
              "$ref": "#/A"
            }
          }
        },
        "views": {
          "additionalProperties": {
            "properties": {
              "detail": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "around": {
                    "type": [
                      "string",
                      "array"
                    ],
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "from": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^(front|plan|side|section_([a-h])\\2)(?![\\s\\S])"
                  },
                  "scale_factor": {
                    "type": "number",
                    "exclusiveMinimum": 1
                  }
                },
                "required": [
                  "around"
                ],
                "additionalProperties": false
              }
            },
            "patternProperties": {
              "^(hidden|centre_(marks|lines)|(thread|knurl)_depiction)$(?!\n)": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "dimension_source": {
          "enum": [
            "auto",
            "authored"
          ]
        },
        "hole_table": {
          "enum": [
            "auto",
            "always",
            "never"
          ]
        },
        "feature_declarations": {
          "items": {
            "properties": {
              "faces": {
                "$ref": "#/B"
              }
            },
            "additionalProperties": {
              "type": "string"
            },
            "required": [
              "id",
              "kind",
              "faces"
            ],
            "maxProperties": 3
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(views|dimensions|annotations|features|faces|dimension_schemes)$(?!\n)": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "^(notes|tables|gears|feature_declarations)$(?!\n)": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "part": {
      "type": "integer",
      "minimum": 0
    },
    "detail": {
      "type": "boolean"
    },
    "problem_filter": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            null,
            "info",
            "warning",
            "error"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(code|subject|feature)$(?!\n)": {
          "$ref": "#/A"
        }
      }
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "step"
      ]
    },
    {
      "required": [
        "part_ref"
      ]
    }
  ],
  "patternProperties": {
    "^(spec_version|step|features|(part|drawing)_ref)$(?!\n)": {
      "type": "string"
    }
  },
  "A": {
    "type": [
      "string",
      "null"
    ]
  },
  "B": {
    "items": {
      "type": "string"
    },
    "type": "array"
  }
}
