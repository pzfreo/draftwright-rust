{
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "draftwright.spec/1",
            "draftwright.spec/2"
          ]
        },
        "binding": {
          "type": [
            "object",
            "null"
          ]
        },
        "sheets": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "smallest_scale": {
              "type": [
                "string",
                "null"
              ]
            },
            "keep_together": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "gdt_on_sheet_1": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(max|hole_table)$(?!\\s)": {
              "enum": [
                null,
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                9
              ]
            }
          }
        },
        "sheet": {
          "type": "object",
